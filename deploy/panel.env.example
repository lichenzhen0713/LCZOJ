# =============================================================================
#  LCZOJ 启动参数模板（面板部署用）
#
#  用法（宝塔 / 小皮 / PM2 / systemd 都可照抄这里的键值对）：
#    1) 复制成 deploy/panel.env（这个文件名不会进版本库）
#    2) 按需修改下面的值
#    3) 用启动脚本加载：bash deploy/panel-start.sh
#       或在面板的「环境变量」里逐条填写同样的键值
# =============================================================================

# 站点端口。面板上 80/443 一般被 Nginx 占用，所以这里用 3000，
# 再由面板站点做反向代理：http://127.0.0.1:3000
PORT=3000

# 监听地址：127.0.0.1 = 只允许本机（Nginx 反代）访问，最安全；
# 要直接用 IP:端口 访问就改成 0.0.0.0
OJ_HOST=127.0.0.1

# 数据目录（数据库 oj.db、题库测试数据、附件、头像、判题缓存都在这里）。
# 留空 = 项目目录下的 data/。想放到数据盘就写绝对路径，例如 /www/lczoj-data
# OJ_DATA_DIR=/www/lczoj-data

# 并行判题数：按服务器核数设置，留 1~2 核给系统与数据库；范围 1~16
OJ_MAX_JUDGES=4

# 时区（页面时间显示）
TZ=Asia/Shanghai

# 运行环境标记
NODE_ENV=production
