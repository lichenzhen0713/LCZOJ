# =============================================================================
#  LCZOJ 启动参数模板（面板部署用）
#
#  用法（宝塔 / 小皮 / PM2 / systemd 都可照抄这里的键值对）：
#    1) 复制成 deploy/panel.env（这个文件名不会进版本库）
#    2) 按需修改下面的值
#    3) 用启动脚本加载：bash deploy/panel-start.sh
#       或在面板的「环境变量」里逐条填写同样的键值
# =============================================================================

# 站点端口。面板上 80/443 一般被 Nginx 占用，所以这里用 3000，
# 再由面板站点做反向代理：http://127.0.0.1:3000
PORT=3000

# 监听地址：127.0.0.1 = 只允许本机（Nginx 反代）访问，最安全；
# 要直接用 IP:端口 访问就改成 0.0.0.0
OJ_HOST=127.0.0.1

# 数据目录（数据库 oj.db、题库测试数据、附件、头像、判题缓存都在这里）。
# 留空 = 项目目录下的 data/。想放到数据盘就写绝对路径，例如 /www/lczoj-data
# OJ_DATA_DIR=/www/lczoj-data

# 并行判题数：按服务器核数设置，留 1~2 核给系统与数据库；范围 1~16
OJ_MAX_JUDGES=4

# 时区（页面时间显示）
TZ=Asia/Shanghai

# 运行环境标记
NODE_ENV=production

# ---------------------------------------------------------------------------
#  OAuth2 授权登录（让 Lith Tools 用 LCZOJ 账号登录）
#
#  只在需要「第三方站点使用 LCZOJ 登录」时配置；不配置时 OAuth 接口统一返回「未启用」，
#  原有账号密码登录完全不受影响。
#
#  1) 生成一个足够长的密钥（至少 32 个字符），例如：
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  2) 把同一组 ID / 密钥同时填到 LCZOJ 与 Lith Tools 的环境变量里；
#  3) 回调地址必须与 Lith Tools 的 LCZOJ_REDIRECT_URI 完全一致（协议、域名、端口、路径都不能差）。
# ---------------------------------------------------------------------------
# OJ_OAUTH_CLIENT_ID=lith-tools
# OJ_OAUTH_CLIENT_SECRET=请替换为随机密钥
# OJ_OAUTH_CLIENT_NAME=Lith Tools
# OJ_OAUTH_REDIRECT_URIS=http://127.0.0.1:8787/api/auth/lczoj/callback
